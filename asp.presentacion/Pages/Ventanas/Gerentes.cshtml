@page
@model asp.presentacion.Pages.Ventanas.GerentesModel
@{
    ViewData["Title"] = "Gerentes";
}

<h2>Gerentes</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.empleado" class="form-label">Empleado</label>
        <select asp-for="Entidad.empleado" class="form-select" required>
            <option value="">-- Seleccione un empleado --</option>
            @foreach (var e in Model.ListaEmpleados)
            {
                <option value="@e.id">@e.nombre (@e.cargo)</option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.nivel_autorizacion" class="form-label">Nivel de autorización</label>
        <select asp-for="Entidad.nivel_autorizacion" class="form-select">
            <option value="Total">Total</option>
            <option value="Alto">Alto</option>
            <option value="Medio">Medio</option>
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.bono_desempeno" class="form-label">Bono desempeño ($)</label>
        <input asp-for="Entidad.bono_desempeno" type="number" step="0.01" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.area_responsable" class="form-label">Área responsable</label>
        <input asp-for="Entidad.area_responsable" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Gerentes" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.area_responsable" class="form-control" placeholder="Buscar por área responsable" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Empleado</th>
            <th>Nivel autorización</th>
            <th>Bono desempeño</th>
            <th>Área responsable</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            var emp = Model.ListaEmpleados.FirstOrDefault(e => e.id == item.empleado);
            <tr>
                <td>@item.id</td>
                <td>@(emp?.nombre ?? $"Empleado #{item.empleado}")</td>
                <td>@item.nivel_autorizacion</td>
                <td>$ @item.bono_desempeno.ToString("N2")</td>
                <td>@item.area_responsable</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('¿Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>