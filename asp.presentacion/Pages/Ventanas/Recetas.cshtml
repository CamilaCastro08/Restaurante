@page
@model asp.presentacion.Pages.Ventanas.RecetasModel
@{
    ViewData["Title"] = "Recetas";
}

<h2>Recetas</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.producto" class="form-label"></label>
        <input asp-for="Entidad.producto" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.tiempo_preparacion" class="form-label"></label>
        <input asp-for="Entidad.tiempo_preparacion" type="datetime-local" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.instrucciones" class="form-label"></label>
        <input asp-for="Entidad.instrucciones" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.porciones" class="form-label"></label>
        <input asp-for="Entidad.porciones" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.dificultad" class="form-label"></label>
        <input asp-for="Entidad.dificultad" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Recetas" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.instrucciones" class="form-control" placeholder="Buscar por instrucciones" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Producto</th>
            <th>Tiempo preparacion</th>
            <th>Instrucciones</th>
            <th>Porciones</th>
            <th>Dificultad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.producto</td>
                <td>@item.tiempo_preparacion</td>
                <td>@item.instrucciones</td>
                <td>@item.porciones</td>
                <td>@item.dificultad</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
