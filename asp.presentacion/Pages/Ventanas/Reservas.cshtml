@page
@model asp.presentacion.Pages.Ventanas.ReservasModel
@{
    ViewData["Title"] = "Reservas";
}

<h2>Reservas</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.cliente" class="form-label"></label>
        <input asp-for="Entidad.cliente" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.mesa" class="form-label"></label>
        <input asp-for="Entidad.mesa" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.fecha_hora" class="form-label"></label>
        <input asp-for="Entidad.fecha_hora" type="datetime-local" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.numero_personas" class="form-label"></label>
        <input asp-for="Entidad.numero_personas" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.estado" class="form-label"></label>
        <input asp-for="Entidad.estado" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Reservas" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.estado" class="form-control" placeholder="Buscar por estado" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Cliente</th>
            <th>Mesa</th>
            <th>Fecha hora</th>
            <th>Numero personas</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.cliente</td>
                <td>@item.mesa</td>
                <td>@item.fecha_hora</td>
                <td>@item.numero_personas</td>
                <td>@item.estado</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
