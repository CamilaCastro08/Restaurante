@page
@model asp.presentacion.Pages.Ventanas.FacturasModel
@{
    ViewData["Title"] = "Facturas";
}

<h2>Facturas</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.pedido" class="form-label">Pedido</label>
        <select asp-for="Entidad.pedido" class="form-select" required>
            <option value="">-- Seleccione un pedido --</option>
            @foreach (var p in Model.ListaPedidos)
            {
                <option value="@p.id">Pedido #@p.id - Mesa @p.mesa (@p.estado)</option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.numero" class="form-label">Número de factura</label>
        <input asp-for="Entidad.numero" class="form-control" required />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.fecha_emision" class="form-label">Fecha emisión</label>
        <input asp-for="Entidad.fecha_emision" type="datetime-local" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.subtotal" class="form-label">Subtotal ($)</label>
        <input asp-for="Entidad.subtotal" type="number" step="0.01" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.total" class="form-label">Total ($)</label>
        <input asp-for="Entidad.total" type="number" step="0.01" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Facturas" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.numero" class="form-control" placeholder="Buscar por número" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Pedido</th>
            <th>Número</th>
            <th>Fecha emisión</th>
            <th>Subtotal</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>Pedido #@item.pedido</td>
                <td>@item.numero</td>
                <td>@item.fecha_emision.ToString("dd/MM/yyyy HH:mm")</td>
                <td>$ @item.subtotal.ToString("N2")</td>
                <td>$ @item.total.ToString("N2")</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('¿Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>