@page
@model asp.presentacion.Pages.Ventanas.UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<h2>Usuarios</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.nombreUsuario" class="form-label">Nombre de Usuario</label>
        <input asp-for="Entidad.nombreUsuario" class="form-control" required />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.correo" class="form-label">Correo</label>
        <input asp-for="Entidad.correo" type="email" class="form-control" required />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.contraseña" class="form-label">Contraseña (en edición dejar vacío para conservar la actual)</label>
        <input asp-for="Entidad.contraseña" type="password" autocomplete="new-password" class="form-control" value="" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.rol" class="form-label">Rol</label>
        <select asp-for="Entidad.rol" class="form-select" required>
            <option value="">-- Seleccione un rol --</option>
            @foreach (var r in Model.ListaRoles)
            {
                <option value="@r.id">@r.nombre</option>
            }
        </select>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Entidad.activo" class="form-check-input" />
        <label asp-for="Entidad.activo" class="form-check-label">Activo</label>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Usuarios" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.nombreUsuario" class="form-control" placeholder="Buscar por nombre de usuario" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Usuario</th>
            <th>Correo</th>
            <th>Activo</th>
            <th>Rol</th>
            <th>Fecha Creación</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            var rol = Model.ListaRoles.FirstOrDefault(r => r.id == item.rol);
            <tr>
                <td>@item.id</td>
                <td>@item.nombreUsuario</td>
                <td>@item.correo</td>
                <td>@(item.activo ? "Sí" : "No")</td>
                <td>@(rol?.nombre ?? $"Rol #{item.rol}")</td>
                <td>@item.fechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('¿Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>