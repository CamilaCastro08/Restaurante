@page
@model asp.presentacion.Pages.Ventanas.MeserosModel
@{
    ViewData["Title"] = "Meseros";
}

<h2>Meseros</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.empleado" class="form-label"></label>
        <input asp-for="Entidad.empleado" class="form-control" type="number" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.zona_asignada" class="form-label"></label>
        <input asp-for="Entidad.zona_asignada" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.num_mesas_asignadas" class="form-label"></label>
        <input asp-for="Entidad.num_mesas_asignadas" class="form-control" type="number" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.calificacion_promedio" class="form-label"></label>
        <input asp-for="Entidad.calificacion_promedio" class="form-control" type="number" step="0.01" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Meseros" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.zona_asignada" class="form-control" placeholder="Buscar por zona asignada" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Empleado</th>
            <th>Zona asignada</th>
            <th>Num mesas asignadas</th>
            <th>Calificacion promedio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.empleado</td>
                <td>@item.zona_asignada</td>
                <td>@item.num_mesas_asignadas</td>
                <td>@item.calificacion_promedio</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
