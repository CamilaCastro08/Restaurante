@page
@model asp.presentacion.Pages.Ventanas.CocinerosModel
@{
    ViewData["Title"] = "Cocineros";
}

<h2>Cocineros</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.empleado" class="form-label">Empleado</label>
        <select asp-for="Entidad.empleado" class="form-select" required>
            <option value="">-- Seleccione un empleado --</option>
            @foreach (var e in Model.ListaEmpleados)
            {
                <option value="@e.id">@e.nombre (@e.cargo)</option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.especialidad" class="form-label">Especialidad</label>
        <input asp-for="Entidad.especialidad" class="form-control" required />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.anios_experiencia" class="form-label">Años de experiencia</label>
        <input asp-for="Entidad.anios_experiencia" type="number" min="0" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.estacion_asignada" class="form-label">Estación asignada</label>
        <input asp-for="Entidad.estacion_asignada" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Cocineros" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.especialidad" class="form-control" placeholder="Buscar por especialidad" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Empleado</th>
            <th>Especialidad</th>
            <th>Años experiencia</th>
            <th>Estación asignada</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            var emp = Model.ListaEmpleados.FirstOrDefault(e => e.id == item.empleado);
            <tr>
                <td>@item.id</td>
                <td>@(emp?.nombre ?? $"Empleado #{item.empleado}")</td>
                <td>@item.especialidad</td>
                <td>@item.anios_experiencia</td>
                <td>@item.estacion_asignada</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('¿Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>