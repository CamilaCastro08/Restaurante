@page
@model asp.presentacion.Pages.Ventanas.Detalles_PedidosModel
@{
    ViewData["Title"] = "Detalles de Pedidos";
}

<div class="rt-card">
    <div class="rt-card-head">
        <h1>Detalles de Pedidos</h1>
        <button type="button" class="btn btn-oro" onclick="abrirModalDetalle()">+ Agregar producto a pedido</button>
    </div>

    <div class="rt-card-body">
        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="alert alert-danger py-2">@Model.Mensaje</div>
        }

        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-registros" type="button">
                    Registros (@Model.Lista.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-auditoria" type="button">
                    Auditoría (@Model.ListaAuditorias.Count)
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-registros">
                <form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
                    <div class="col-md-4">
                        <select asp-for="Filtro.pedido" class="form-select">
                            <option value="0">-- Todos los pedidos --</option>
                            @foreach (var p in Model.ListaPedidos)
                            {
                                <option value="@p.id">Pedido #@p.id · Mesa @(p._mesa?.numero ?? p.mesa)</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-oro">Filtrar</button>
                        <a asp-page="Detalles_Pedidos" class="btn btn-fantasma">Todos</a>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="rt-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Pedido</th>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Subtotal</th>
                                <th>Comentarios</th>
                                <th class="acciones">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Lista.Count == 0)
                            {
                                <tr><td colspan="7" class="text-center text-tenue py-4">Sin detalles registrados</td></tr>
                            }
                            else
                            {
                                foreach (var item in Model.Lista)
                                {
                                    var nomProd = item._producto?.nombre
                                        ?? Model.ListaProductos.FirstOrDefault(p => p.id == item.producto)?.nombre
                                        ?? $"Producto #{item.producto}";
                                    <tr>
                                        <td>@item.id</td>
                                        <td>Pedido #@item.pedido</td>
                                        <td><strong>@nomProd</strong></td>
                                        <td>@item.cantidad</td>
                                        <td>$@item.subtotal.ToString("N2")</td>
                                        <td class="text-tenue">@item.comentarios</td>
                                        <td class="acciones">
                                            <button type="button" class="btn btn-sm btn-fantasma"
                                                    onclick='abrirModalDetalle({
                                                        id: @item.id,
                                                        pedido: @item.pedido,
                                                        producto: @item.producto,
                                                        cantidad: @item.cantidad,
                                                        subtotal: @item.subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture),
                                                        comentarios: "@(item.comentarios ?? "")"
                                                    })'>Editar</button>
                                            <form method="post" asp-page-handler="Borrar" asp-route-id="@item.id" class="d-inline" onsubmit="return rtConfirmarBorrado(event)">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Borrar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-auditoria">
                <partial name="_AuditoriaTab" model="Model.ListaAuditorias" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalle" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Guardar" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> detalle de pedido</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Entidad.id" value="0" />

                <div class="mb-3">
                    <label class="form-label">Pedido</label>
                    <select name="Entidad.pedido" class="form-select" required>
                        <option value="">-- Seleccione un pedido --</option>
                        @foreach (var p in Model.ListaPedidos)
                        {
                            <option value="@p.id">Pedido #@p.id · Mesa @(p._mesa?.numero ?? p.mesa) (@p.estado)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Producto</label>
                    <select name="Entidad.producto" class="form-select" required>
                        <option value="">-- Seleccione un producto --</option>
                        @foreach (var pr in Model.ListaProductos)
                        {
                            <option value="@pr.id">@pr.nombre (@pr.tipo)</option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Cantidad</label>
                        <input name="Entidad.cantidad" type="number" min="1" value="1" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Subtotal ($)</label>
                        <input name="Entidad.subtotal" type="number" step="0.01" min="0" class="form-control" required />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Comentarios</label>
                    <input name="Entidad.comentarios" class="form-control" placeholder="Ej. Sin cebolla, término medio..." />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-oro">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalDetalle(datos) {
            rtAbrirModal('modalDetalle', datos);
            if (!datos) {
                var f = document.querySelector('#modalDetalle form');
                f.querySelector('[name="Entidad.id"]').value = '0';
                f.querySelector('[name="Entidad.cantidad"]').value = '1';
            }
        }
    </script>
}