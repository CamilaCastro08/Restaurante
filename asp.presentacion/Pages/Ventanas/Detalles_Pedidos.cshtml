@page
@model asp.presentacion.Pages.Ventanas.Detalles_PedidosModel
@{
    ViewData["Title"] = "Detalles_Pedidos";
}

<h2>Detalles de Pedidos</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.pedido" class="form-label">Pedido</label>
        <select asp-for="Entidad.pedido" class="form-select" required>
            <option value="">-- Seleccione un pedido --</option>
            @foreach (var p in Model.ListaPedidos)
            {
                <option value="@p.id">Pedido #@p.id - Mesa @p.mesa (@p.estado)</option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.producto" class="form-label">Producto</label>
        <select asp-for="Entidad.producto" id="selectProducto" class="form-select" required onchange="calcularSubtotal()">
            <option value="" data-precio="0">-- Seleccione un producto --</option>
            @foreach (var prod in Model.ListaProductos)
            {
                <option value="@prod.id" data-precio="@prod.precio.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @prod.nombre ($ @prod.precio.ToString("N0"))
                </option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.cantidad" class="form-label">Cantidad</label>
        <input asp-for="Entidad.cantidad" id="inputCantidad" type="number" min="1" class="form-control" required oninput="calcularSubtotal()" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.subtotal" class="form-label">Subtotal calculado ($)</label>
        <input asp-for="Entidad.subtotal" id="inputSubtotal" type="number" step="0.01" class="form-control bg-light fw-bold text-success" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.comentarios" class="form-label">Comentarios</label>
        <input asp-for="Entidad.comentarios" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Detalles_Pedidos" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <select asp-for="Filtro.pedido" class="form-select">
            <option value="0">-- Todos los pedidos --</option>
            @foreach (var p in Model.ListaPedidos)
            {
                <option value="@p.id">Pedido #@p.id - Mesa @p.mesa</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Pedido</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th>Comentarios</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            var prod = Model.ListaProductos.FirstOrDefault(p => p.id == item.producto);
            <tr>
                <td>@item.id</td>
                <td>Pedido #@item.pedido</td>
                <td>@(prod?.nombre ?? $"Producto #{item.producto}")</td>
                <td>@item.cantidad</td>
                <td>$ @item.subtotal.ToString("N2")</td>
                <td>@item.comentarios</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('¿Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function calcularSubtotal() {
            const select = document.getElementById('selectProducto');
            const cantidad = parseFloat(document.getElementById('inputCantidad').value) || 0;
            const opcion = select.options[select.selectedIndex];
            const precio = parseFloat(opcion ? opcion.getAttribute('data-precio') : '0') || 0;
            document.getElementById('inputSubtotal').value = (precio * cantidad).toFixed(2);
        }
        document.addEventListener('DOMContentLoaded', calcularSubtotal);
    </script>
}