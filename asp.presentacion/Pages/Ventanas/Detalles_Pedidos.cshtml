@page
@model asp.presentacion.Pages.Ventanas.Detalles_PedidosModel
@{
    ViewData["Title"] = "Detalles_Pedidos";
}

<h2>Detalles_Pedidos</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="post" asp-page-handler="Guardar" class="mb-4">
    <input type="hidden" asp-for="Entidad.id" />
    <div class="mb-2">
        <label asp-for="Entidad.pedido" class="form-label"></label>
        <input asp-for="Entidad.pedido" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.producto" class="form-label"></label>
        <input asp-for="Entidad.producto" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.cantidad" class="form-label"></label>
        <input asp-for="Entidad.cantidad" type="number" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.subtotal" class="form-label"></label>
        <input asp-for="Entidad.subtotal" type="number" step="0.01" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.comentarios" class="form-label"></label>
        <input asp-for="Entidad.comentarios" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Detalles_Pedidos" class="btn btn-secondary">Nuevo</a>
</form>

<form method="post" asp-page-handler="Buscar" class="row g-2 mb-3">
    <div class="col">
        <input asp-for="Filtro.pedido" type="number" class="form-control" placeholder="Buscar por pedido" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Pedido</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th>Comentarios</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.pedido</td>
                <td>@item.producto</td>
                <td>@item.cantidad</td>
                <td>@item.subtotal</td>
                <td>@item.comentarios</td>
                <td>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-page-handler="Editar" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</button>
                        <button type="submit" asp-page-handler="Borrar" asp-route-id="@item.id" class="btn btn-sm btn-danger" onclick="return confirm('Borrar este registro?')">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
