@page
@model LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Acceso";
}

<div class="rt-login-wrap">
    <form method="post" class="rt-login">
        <div class="marca">
            <div class="rt-brand justify-content-center">
                <span class="emblema"></span>
                <span class="nombre" style="font-size:1.5rem">Restaurante <b>Gourmet</b></span>
            </div>
            <p class="text-tenue mt-2 mb-0">Acceso al sistema de gestión</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="alert alert-danger py-2">@Model.Mensaje</div>
        }

        <div class="mb-3">
            <label class="form-label" asp-for="NombreUsuario">Usuario</label>
            <input class="form-control" asp-for="NombreUsuario" placeholder="Usuario" autofocus required />
        </div>
        <div class="mb-4">
            <label class="form-label" asp-for="Contrasena">Contraseña</label>
            <input class="form-control" type="password" asp-for="Contrasena" placeholder="•••••" required />
        </div>

        <button type="submit" class="btn btn-oro w-100 py-2">Iniciar sesión</button>

        <p class="text-tenue text-center mt-3 mb-0" style="font-size:.8rem">
            Administrador · Mesero
        </p>
    </form>
</div>