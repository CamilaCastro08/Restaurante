@page
@model LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Iniciar sesion";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h1 class="h3 text-center mb-3">Iniciar sesion</h1>
        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="alert alert-danger">@Model.Mensaje</div>
        }
        <form method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="NombreUsuario">Usuario</label>
                <input class="form-control" asp-for="NombreUsuario" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Contrasena">Contraseña</label>
                <input class="form-control" type="password" asp-for="Contrasena" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
    </div>
</div>
