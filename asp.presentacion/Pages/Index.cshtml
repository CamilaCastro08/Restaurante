@page
@model IndexModel
@{
    ViewData["Title"] = "Restaurante";
}

<div class="text-center">
    <h1 class="display-4">Restaurante</h1>
    <p>Bienvenido, @Model.HttpContext.Session.GetString("nombre")</p>
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-warning">@TempData["Mensaje"]</div>
    }
</div>
