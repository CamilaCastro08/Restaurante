@page
@model IndexModel
@{
    ViewData["Title"] = "Panel Principal - Restaurante";
    var nombre = HttpContext.Session.GetString("nombre") ?? "Usuario";
}


<div class="p-5 mb-4 rounded-3 text-white shadow" style="background: linear-gradient(135deg, #1f1c18 0%, #362e24 50%, #544431 100%);">
    <div class="container-fluid py-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
              
                <h1 class="display-5 fw-bold mb-1">🍴 Restaurante Gourmet </h1>
                <p class="col-md-9 fs-5 text-light opacity-75 mb-0">
                    Bienvenido, <strong>@nombre</strong>.
                </p>
            </div>
            <div class="d-flex flex-column gap-2">
                <a asp-page="/Ventanas/MapaMesas" class="btn btn-warning btn-lg fw-bold px-4">
                    <i class="bi bi-grid-3x3-gap"></i> Abrir Mapa de Mesas
                </a>
                <a asp-page="/Ventanas/Reportes" class="btn btn-outline-light px-4">
                    <i class="bi bi-file-earmark-bar-graph"></i> Reportes PDF / Excel
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100 bg-white border-start border-success border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Mesas Disponibles</div>
                        <div class="fs-2 fw-bold text-success">@Model.MesasDisponibles <span class="fs-6 text-muted">/ @Model.TotalMesas</span></div>
                    </div>
                    <div class="p-3 bg-success-subtle rounded-circle">
                        <i class="bi bi-table fs-3 text-success"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    <i class="bi bi-people text-danger"></i> @Model.MesasOcupadas ocupadas ahora
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100 bg-white border-start border-primary border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pedidos Registrados</div>
                        <div class="fs-2 fw-bold text-primary">@Model.TotalPedidos</div>
                    </div>
                    <div class="p-3 bg-primary-subtle rounded-circle">
                        <i class="bi bi-receipt fs-3 text-primary"></i>
                    </div>
                </div>
                <div class="mt-2 small">
                    <a asp-page="/Ventanas/Pedidos" class="text-decoration-none">Ver pedidos &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100 bg-white border-start border-warning border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Facturación Total</div>
                        <div class="fs-2 fw-bold text-dark">$ @Model.TotalVentas.ToString("N0")</div>
                    </div>
                    <div class="p-3 bg-warning-subtle rounded-circle">
                        <i class="bi bi-cash-stack fs-3 text-warning"></i>
                    </div>
                </div>
                <div class="mt-2 small">
                    <a asp-page="/Ventanas/Reportes" class="text-decoration-none text-warning fw-semibold">Exportar reporte &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100 bg-white border-start border-danger border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Alertas Inventario</div>
                        <div class="fs-2 fw-bold @(Model.StockCritico > 0 ? "text-danger" : "text-secondary")">
                            @Model.StockCritico
                        </div>
                    </div>
                    <div class="p-3 bg-danger-subtle rounded-circle">
                        <i class="bi bi-box-seam fs-3 text-danger"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    @(Model.StockCritico > 0 ? "Ingredientes bajo el stock mínimo" : "Stock en nivel óptimo")
                </div>
            </div>
        </div>
    </div>
</div>


<h4 class="fw-bold mb-3"><i class="bi bi-compass"></i> Módulos Operativos Principales</h4>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 bg-primary text-white rounded-3">
                        <i class="bi bi-map fs-2"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Mapa</h5>
                        <small class="text-muted"></small>
                    </div>
                </div>
                <p class="text-muted flex-grow-1 small">
                  
                </p>
                <a asp-page="/Ventanas/MapaMesas" class="btn btn-outline-primary w-100">
                    Ir al Mapa <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 bg-success text-white rounded-3">
                        <i class="bi bi-file-earmark-spreadsheet fs-2"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Reportes Ejecutivos</h5>
                        <small class="text-muted"></small>
                    </div>
                </div>
                <p class="text-muted flex-grow-1 small">
                   
                </p>
                <a asp-page="/Ventanas/Reportes" class="btn btn-outline-success w-100">
                    Abrir Reportes <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 bg-dark text-white rounded-3">
                        <i class="bi bi-printer fs-2"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Impresión </h5>
                        <small class="text-muted"></small>
                    </div>
                </div>
                <p class="text-muted flex-grow-1 small">
                   
                </p>
                <a asp-page="/Ventanas/Impresion" class="btn btn-outline-dark w-100">
                    Imprimir  <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>


<div class="card border-0 shadow-sm bg-light">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-check2-all text-success"></i> </h5>
                
            </div>
            <div 
             
        </div>
    </div>
</div>
