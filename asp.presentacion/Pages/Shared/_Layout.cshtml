@{
    var nombre = Context.Session.GetString("nombre");
    var permisos = (Context.Session.GetString("permisos") ?? "").Split(',');
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurante</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/asp.presentacion.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-4 py-2">
            <div class="container">
                <a class="navbar-brand fw-bold text-warning d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-egg-fried fs-4"></i> Restaurante Gourmet
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (!string.IsNullOrEmpty(nombre))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            @if (permisos.Contains("Categorias") || permisos.Contains("Menus") || permisos.Contains("Productos") || permisos.Contains("Recetas") || permisos.Contains("Ingredientes") || permisos.Contains("Inventarios") || permisos.Contains("Proveedores"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-book"></i> Carta</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Categorias"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Categorias">Categorias</a></li>
                                    }
                                    @if (permisos.Contains("Menus"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Menus">Menus</a></li>
                                    }
                                    @if (permisos.Contains("Productos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Productos">Productos</a></li>
                                    }
                                    @if (permisos.Contains("Recetas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Recetas">Recetas</a></li>
                                    }
                                    @if (permisos.Contains("Ingredientes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Ingredientes">Ingredientes</a></li>
                                    }
                                    @if (permisos.Contains("Inventarios"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Inventarios">Inventarios</a></li>
                                    }
                                    @if (permisos.Contains("Proveedores"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Proveedores">Proveedores</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Mesas") || permisos.Contains("Reservas") || permisos.Contains("Clientes") || permisos.Contains("Pedidos") || permisos.Contains("Detalles_Pedidos") || permisos.Contains("MapaMesas"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-shop"></i> Salon</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("MapaMesas"))
                                    {
                                        <li><a class="dropdown-item fw-bold text-primary" asp-page="/Ventanas/MapaMesas"><i class="bi bi-map"></i> Mapa de Mesas</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    @if (permisos.Contains("Mesas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Mesas">Mesas</a></li>
                                    }
                                    @if (permisos.Contains("Reservas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Reservas">Reservas</a></li>
                                    }
                                    @if (permisos.Contains("Clientes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Clientes">Clientes</a></li>
                                    }
                                    @if (permisos.Contains("Pedidos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Pedidos">Pedidos</a></li>
                                    }
                                    @if (permisos.Contains("Detalles_Pedidos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Detalles_Pedidos">Detalles Pedidos</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Facturas") || permisos.Contains("Pagos") || permisos.Contains("MetodosPagos") || permisos.Contains("Impresion"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-cash"></i> Caja</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Impresion"))
                                    {
                                        <li><a class="dropdown-item fw-bold text-primary" asp-page="/Ventanas/Impresion"><i class="bi bi-printer"></i> Impresión Tickets</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    @if (permisos.Contains("Facturas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Facturas">Facturas</a></li>
                                    }
                                    @if (permisos.Contains("Pagos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Pagos">Pagos</a></li>
                                    }
                                    @if (permisos.Contains("MetodosPagos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/MetodosPagos">MetodosPagos</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Empleados") || permisos.Contains("Meseros") || permisos.Contains("Cocineros") || permisos.Contains("Gerentes") || permisos.Contains("Turnos"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-people"></i> Personal</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Empleados"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Empleados">Empleados</a></li>
                                    }
                                    @if (permisos.Contains("Meseros"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Meseros">Meseros</a></li>
                                    }
                                    @if (permisos.Contains("Cocineros"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Cocineros">Cocineros</a></li>
                                    }
                                    @if (permisos.Contains("Gerentes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Gerentes">Gerentes</a></li>
                                    }
                                    @if (permisos.Contains("Turnos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Turnos">Turnos</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Reportes") || permisos.Contains("MapaMesas") || permisos.Contains("Impresion"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-star-fill"></i> Especiales
                                    </a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Reportes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Reportes"><i class="bi bi-file-earmark-bar-graph"></i> Reportes (PDF, Excel)</a></li>
                                    }
                                    @if (permisos.Contains("MapaMesas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/MapaMesas"><i class="bi bi-map"></i> Mapa Interactivo</a></li>
                                    }
                                    @if (permisos.Contains("Impresion"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Impresion"><i class="bi bi-printer"></i> Impresión Comandas</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Usuarios") || permisos.Contains("Roles") || permisos.Contains("Permisos") || permisos.Contains("Auditorias"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-shield-lock"></i> Seguridad</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Usuarios"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Usuarios">Usuarios</a></li>
                                    }
                                    @if (permisos.Contains("Roles"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Roles">Roles</a></li>
                                    }
                                    @if (permisos.Contains("Permisos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Permisos">Permisos</a></li>
                                    }
                                    @if (permisos.Contains("Auditorias"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Auditorias">Auditorias</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="navbar-text text-light me-3">
                                    <i class="bi bi-person-circle"></i> @nombre
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-warning btn-sm" asp-page="/Salir">
                                    <i class="bi bi-box-arrow-right"></i> Salir
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   <!-- <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Restaurante
        </div>
    </footer> -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
