@using Microsoft.AspNetCore.Http
@{
    var nombre = Context.Session.GetString("nombre") ?? "";
    var rol    = Context.Session.GetString("rol") ?? "";
    var perms  = (Context.Session.GetString("permisos") ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries);
    bool esAdmin = rol.Equals("Administrador", StringComparison.OrdinalIgnoreCase);
    bool Tiene(string p) => esAdmin || perms.Contains(p);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Restaurante Gourmet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rt-nav">
            <div class="container">
                <a class="rt-brand" asp-page="/Index">
                    <span class="emblema"></span>
                    <span class="nombre">Restaurante <b>Gourmet</b></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rtNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="rtNav">
                    <ul class="navbar-nav me-auto ms-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Panel</a>
                        </li>

                        @if (Tiene("Pedidos") || Tiene("Detalles_Pedidos") || Tiene("Reservas") || Tiene("Mesas") || Tiene("Clientes"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Operación</a>
                                <ul class="dropdown-menu">
                                    @if (Tiene("Pedidos"))          { <li><a class="dropdown-item" asp-page="/Ventanas/Pedidos">Pedidos</a></li> }
                                    @if (Tiene("Detalles_Pedidos")) { <li><a class="dropdown-item" asp-page="/Ventanas/Detalles_Pedidos">Detalles de Pedidos</a></li> }
                                    @if (Tiene("Reservas"))         { <li><a class="dropdown-item" asp-page="/Ventanas/Reservas">Reservas</a></li> }
                                    @if (Tiene("Mesas"))            { <li><a class="dropdown-item" asp-page="/Ventanas/Mesas">Mesas</a></li> }
                                    @if (Tiene("Clientes"))         { <li><a class="dropdown-item" asp-page="/Ventanas/Clientes">Clientes</a></li> }
                                </ul>
                            </li>
                        }

                        @if (Tiene("Categorias") || Tiene("Menus") || Tiene("Productos") || Tiene("Recetas") || Tiene("Ingredientes") || Tiene("Inventarios") || Tiene("Proveedores"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Carta e Inventario</a>
                                <ul class="dropdown-menu">
                                    @if (Tiene("Categorias"))   { <li><a class="dropdown-item" asp-page="/Ventanas/Categorias">Categorías</a></li> }
                                    @if (Tiene("Menus"))        { <li><a class="dropdown-item" asp-page="/Ventanas/Menus">Menús</a></li> }
                                    @if (Tiene("Productos"))    { <li><a class="dropdown-item" asp-page="/Ventanas/Productos">Productos</a></li> }
                                    @if (Tiene("Recetas"))      { <li><a class="dropdown-item" asp-page="/Ventanas/Recetas">Recetas</a></li> }
                                    @if (Tiene("Ingredientes")) { <li><a class="dropdown-item" asp-page="/Ventanas/Ingredientes">Ingredientes</a></li> }
                                    @if (Tiene("Inventarios"))  { <li><a class="dropdown-item" asp-page="/Ventanas/Inventarios">Inventarios</a></li> }
                                    @if (Tiene("Proveedores"))  { <li><a class="dropdown-item" asp-page="/Ventanas/Proveedores">Proveedores</a></li> }
                                </ul>
                            </li>
                        }

                        @if (Tiene("Empleados") || Tiene("Gerentes") || Tiene("Meseros") || Tiene("Cocineros") || Tiene("Turnos"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Personal</a>
                                <ul class="dropdown-menu">
                                    @if (Tiene("Empleados")) { <li><a class="dropdown-item" asp-page="/Ventanas/Empleados">Empleados</a></li> }
                                    @if (Tiene("Gerentes"))  { <li><a class="dropdown-item" asp-page="/Ventanas/Gerentes">Gerentes</a></li> }
                                    @if (Tiene("Meseros"))   { <li><a class="dropdown-item" asp-page="/Ventanas/Meseros">Meseros</a></li> }
                                    @if (Tiene("Cocineros")) { <li><a class="dropdown-item" asp-page="/Ventanas/Cocineros">Cocineros</a></li> }
                                    @if (Tiene("Turnos"))    { <li><a class="dropdown-item" asp-page="/Ventanas/Turnos">Turnos</a></li> }
                                </ul>
                            </li>
                        }

                        @if (Tiene("Facturas") || Tiene("Pagos") || Tiene("MetodosPagos"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Facturación</a>
                                <ul class="dropdown-menu">
                                    @if (Tiene("Facturas"))     { <li><a class="dropdown-item" asp-page="/Ventanas/Facturas">Facturas</a></li> }
                                    @if (Tiene("Pagos"))        { <li><a class="dropdown-item" asp-page="/Ventanas/Pagos">Pagos</a></li> }
                                    @if (Tiene("MetodosPagos")) { <li><a class="dropdown-item" asp-page="/Ventanas/MetodosPagos">Métodos de Pago</a></li> }
                                </ul>
                            </li>
                        }

                        @if (Tiene("Usuarios") || Tiene("Roles") || Tiene("Permisos") || Tiene("Auditorias"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Sistema</a>
                                <ul class="dropdown-menu">
                                    @if (Tiene("Usuarios"))   { <li><a class="dropdown-item" asp-page="/Ventanas/Usuarios">Usuarios</a></li> }
                                    @if (Tiene("Roles"))      { <li><a class="dropdown-item" asp-page="/Ventanas/Roles">Roles</a></li> }
                                    @if (Tiene("Permisos"))   { <li><a class="dropdown-item" asp-page="/Ventanas/Permisos">Permisos</a></li> }
                                    @if (Tiene("Auditorias")) { <li><a class="dropdown-item" asp-page="/Ventanas/Auditorias">Auditoría General</a></li> }
                                </ul>
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrEmpty(nombre))
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="rt-chip-rol">@rol</span>
                            <span class="text-tenue small">@nombre</span>
                            <a class="btn btn-sm btn-fantasma" asp-page="/Salir">Salir</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="rt-footer">
        <div class="container d-flex justify-content-between small">
            <span>Restaurante Gourmet · Panel de gestión</span>
            <span>@rol</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>