@{
    var nombre = Context.Session.GetString("nombre");
    var permisos = (Context.Session.GetString("permisos") ?? "").Split(',');
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurante</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/asp.presentacion.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Restaurante</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (!string.IsNullOrEmpty(nombre))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            @if (permisos.Contains("Categorias") || permisos.Contains("Menus") || permisos.Contains("Productos") || permisos.Contains("Recetas") || permisos.Contains("Ingredientes") || permisos.Contains("Inventarios") || permisos.Contains("Proveedores"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Carta</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Categorias"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Categorias">Categorias</a></li>
                                    }
                                    @if (permisos.Contains("Menus"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Menus">Menus</a></li>
                                    }
                                    @if (permisos.Contains("Productos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Productos">Productos</a></li>
                                    }
                                    @if (permisos.Contains("Recetas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Recetas">Recetas</a></li>
                                    }
                                    @if (permisos.Contains("Ingredientes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Ingredientes">Ingredientes</a></li>
                                    }
                                    @if (permisos.Contains("Inventarios"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Inventarios">Inventarios</a></li>
                                    }
                                    @if (permisos.Contains("Proveedores"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Proveedores">Proveedores</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Mesas") || permisos.Contains("Reservas") || permisos.Contains("Clientes") || permisos.Contains("Pedidos") || permisos.Contains("Detalles_Pedidos"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Salon</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Mesas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Mesas">Mesas</a></li>
                                    }
                                    @if (permisos.Contains("Reservas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Reservas">Reservas</a></li>
                                    }
                                    @if (permisos.Contains("Clientes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Clientes">Clientes</a></li>
                                    }
                                    @if (permisos.Contains("Pedidos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Pedidos">Pedidos</a></li>
                                    }
                                    @if (permisos.Contains("Detalles_Pedidos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Detalles_Pedidos">Detalles Pedidos</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Facturas") || permisos.Contains("Pagos") || permisos.Contains("MetodosPagos"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Caja</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Facturas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Facturas">Facturas</a></li>
                                    }
                                    @if (permisos.Contains("Pagos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Pagos">Pagos</a></li>
                                    }
                                    @if (permisos.Contains("MetodosPagos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/MetodosPagos">MetodosPagos</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Empleados") || permisos.Contains("Meseros") || permisos.Contains("Cocineros") || permisos.Contains("Gerentes") || permisos.Contains("Turnos"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Personal</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Empleados"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Empleados">Empleados</a></li>
                                    }
                                    @if (permisos.Contains("Meseros"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Meseros">Meseros</a></li>
                                    }
                                    @if (permisos.Contains("Cocineros"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Cocineros">Cocineros</a></li>
                                    }
                                    @if (permisos.Contains("Gerentes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Gerentes">Gerentes</a></li>
                                    }
                                    @if (permisos.Contains("Turnos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Turnos">Turnos</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                            @if (permisos.Contains("Usuarios") || permisos.Contains("Roles") || permisos.Contains("Permisos") || permisos.Contains("Auditorias"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Seguridad</a>
                                    <ul class="dropdown-menu">
                                    @if (permisos.Contains("Usuarios"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Usuarios">Usuarios</a></li>
                                    }
                                    @if (permisos.Contains("Roles"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Roles">Roles</a></li>
                                    }
                                    @if (permisos.Contains("Permisos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Permisos">Permisos</a></li>
                                    }
                                    @if (permisos.Contains("Auditorias"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Auditorias">Auditorias</a></li>
                                    }
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item"><span class="navbar-text me-2">@nombre</span></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Salir">Salir</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Restaurante
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
